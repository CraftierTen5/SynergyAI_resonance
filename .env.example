# Set provider keys in your local .env or secret manager. Never commit real keys.
GROQ_API_KEY=
GEMINI_API_KEY=
PROCESS_LOG_PSEUDONYM_KEY=

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# Local-only demo route with deterministic model and server-owned demo assignments.
# Keep disabled outside local development.
LOCAL_PLACEHOLDER_ENABLED=false

AI_CONNECT_TIMEOUT_SECONDS=5
AI_READ_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=3
AI_RETRY_BASE_SECONDS=0.25
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RECOVERY_SECONDS=30
AI_RESPONSE_CACHE_TTL_SECONDS=300
AI_LOG_STREAM_MAXLEN=100000
DEFAULT_RATE_LIMIT_REQUESTS=60
DEFAULT_RATE_LIMIT_WINDOW_SECONDS=60
PREPROCESS_MAX_TEXT_LENGTH=100000
PREPROCESS_MAX_IMAGE_BYTES=5000000
PREPROCESS_MAX_IMAGES=5

# Data layer. Use rediss:// outside localhost and keep production data in an
# India region unless an institution has approved otherwise (NFR-PRV-05).
POSTGRES_DSN=
REDIS_DSN=redis://localhost:6379/0
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_COMMAND_TIMEOUT_SECONDS=10
POSTGRES_STATEMENT_CACHE_SIZE=100
REDIS_SOCKET_TIMEOUT_SECONDS=5
DATA_REGION=ap-south-1
ALLOW_NON_INDIA_REGION=false

PROCESS_LOG_BUFFER_TTL_SECONDS=900
SESSION_TTL_SECONDS=43200
POLICY_CACHE_TTL_SECONDS=300

PROCESS_DATA_RETENTION_DAYS=365
ASSESSMENT_RETENTION_DAYS=1825
AUDIT_RETENTION_DAYS=2555
ANALYTICS_MIN_COHORT_SIZE=5
